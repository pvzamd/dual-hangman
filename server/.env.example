# Port the HTTP + Socket.IO server listens on. Defaults to 3001.
PORT=3001

# CORS allowed origin for the client app.
# Leave UNSET for local dev and LAN playtesting — the server then reflects the
# request origin so any device on your network can connect (docs/LOCAL_PLAYTESTING.md).
# In production, set it to the deployed client URL to lock CORS down.
# CLIENT_ORIGIN=https://your-client.example.com

# Seconds a disconnected player may reconnect before forfeiting. Defaults to 60.
# Lower it (e.g. 2) in tests that exercise the grace-expiry forfeit path.
RECONNECT_GRACE_SECONDS=60
