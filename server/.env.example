# Port the HTTP + Socket.IO server listens on. Defaults to 3001.
PORT=3001

# CORS allowed origin for the client app. Defaults to http://localhost:5173.
# In production set this to the deployed client URL.
CLIENT_ORIGIN=http://localhost:5173

# Seconds a disconnected player may reconnect before forfeiting. Defaults to 60.
# Lower it (e.g. 2) in tests that exercise the grace-expiry forfeit path.
RECONNECT_GRACE_SECONDS=60
